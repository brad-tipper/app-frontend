{
  "name": "@brad-tipper/app-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Shared client runtime for apps talking to a Silverstripe API built on app-backend: session store, refresh-on-401, error helpers, hey-api preset, e2e helpers.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./storage": "./src/storage.ts",
    "./tickets": "./src/tickets/index.ts",
    "./openapi-ts": {
      "types": "./openapi-ts.preset.d.mts",
      "default": "./openapi-ts.preset.mjs"
    },
    "./e2e": {
      "types": "./src/e2e/index.d.mts",
      "default": "./src/e2e/index.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "*",
    "expo-secure-store": "*",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.105.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
