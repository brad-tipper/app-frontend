{
  "name": "@brad-tipper/app-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Shared client runtime for apps talking to a Silverstripe API built on app-backend: session store, refresh-on-401, error helpers, hey-api preset, e2e helpers.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./storage": "./src/storage.ts",
    "./openapi-ts": "./openapi-ts.preset.mjs",
    "./e2e": "./src/e2e/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "expo-secure-store": "*",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo-secure-store": { "optional": true },
    "react-native": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
